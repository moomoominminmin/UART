# /mnt/NewHDD/home/lab_2022104219/sch_folder/PCORNER.LEF, written by L-Edit Version 2022.2U3 on Sat Nov 28 16:29:23 2026

VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS
   DATABASE MICRONS 1000 ;
END UNITS

MANUFACTURINGGRID 0.01 ;

MACRO PCORNER
   FOREIGN PCORNER ;
   SITE IO ;
   CLASS PAD ;
   SIZE 200 BY 200 ;   # fixed MPW frame: box must end before the end pads (298 um from die edge).
   # MET3 ring arms still run to 251.5 and overlap the end pads' MET3 rings (same nets).
   # MET1/MET2/VIA1/VIA2 removed from OBS -> delete them in the PCORNER layout (L-Edit) too.
   PIN VSS
      DIRECTION INPUT ;
      USE GROUND ;
      SHAPE ABUTMENT ;
      PORT 
         LAYER MET3 ;
             RECT 244.65 48.39 251.5 78 ;
            RECT 48.39 244.65 78 251.5 ;
      END
   END VSS

   PIN VDD
      DIRECTION INPUT ;
      USE POWER ;
      SHAPE ABUTMENT ;
      PORT 
         LAYER MET3 ;
             RECT 244.65 -0.01 251.5 29.6 ;
            RECT -0.01 244.65 29.6 251.5 ;
      END
   END VDD

   OBS
      LAYER MET3 ;
         POLYGON 251.5 48.39
           135.25 48.39
           48.39 135.25
           48.39 251.5
           78 251.5
           78 147.6
           147.6 78
           251.5 78 ;
         POLYGON 251.5 0
           87.6 0
           0 87.6
           0 251.5
           29.6 251.5
           29.6 99.93
           99.93 29.6
           251.5 29.6 ;
   END
END PCORNER



MACRO IOX1

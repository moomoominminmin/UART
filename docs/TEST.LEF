      DIRECTION INPUT ;
      USE POWER ;
      SHAPE ABUTMENT ;
      PORT 
         LAYER MET3 ;
             RECT 0 91.5 26.62 121.1 ;
      END
   END VDD

   PIN VSS
      DIRECTION INPUT ;
      USE GROUND ;
      SHAPE ABUTMENT ;
      PORT 
         LAYER MET3 ;
             RECT 0.01 139.89 26.63 169.49 ;
      END
   END VSS

   OBS
      LAYER MET3 ;
         RECT 0.01 139.89 26.63 169.49 ;
         RECT 0 91.5 26.62 121.1 ;
   END
END IOX1


